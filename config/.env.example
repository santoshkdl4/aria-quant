# ARIA QUANT Environment Configuration
# DO NOT commit real secrets to the repository.

# Application Mode
LIVE_TRADING_ENABLED=False
ENVIRONMENT=development

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Database Paths (relative to project root)
STATE_DB_PATH=data/databases/aria_state.db
MEMORY_DB_PATH=data/databases/aria_memory.db
MARKET_DATA_PATH=data/parquet/

# Logging
LOG_LEVEL=INFO
